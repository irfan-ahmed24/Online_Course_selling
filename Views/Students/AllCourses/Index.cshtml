@model IEnumerable<My_project.Models.Course>

@{
    ViewData["Title"] = "Explore All Courses";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Explore All Courses</h3>
            <p class="text-muted small">Discover professional courses, learn new skills, and advance your career.</p>
        </div>
        <!-- Search Bar -->
        <div class="w-25">
            <input type="text" class="form-control rounded-pill shadow-sm px-3" placeholder="Search courses...">
        </div>
    </div>

    <!-- Category Filter Buttons -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">All Courses</button>
        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">Web Development</button>
        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">Backend & API</button>
        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">UI/UX Design</button>
        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">Data Science</button>
    </div>

    <!-- Courses Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var course in Model)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                        <!-- Course Thumbnail / Image Section -->
                        <div class="position-relative" style="height: 170px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                            {
                                <img src="@course.ThumbnailUrl" alt="@course.Title" class="w-100 h-100 object-fit-cover">
                            }
                            else
                            {
                                <div
                                    class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center w-100 h-100">
                                    <i class="bi bi-file-earmark-play fs-1 opacity-75"></i>
                                </div>
                            }

                            <span class="position-absolute top-0 end-0 m-3 badge bg-danger px-3 py-2 rounded-pill">
                                Featured
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <span class="text-muted small fw-semibold mb-1">
                                Instructor: @(course.Teacher != null ? course.Teacher.FullName : "Expert")
                            </span>
                            <h5 class="fw-bold text-dark mb-2">@course.Title</h5>
                            <p class="text-muted small mb-3">
                                @(course.Description != null && course.Description.Length > 90 ? course.Description.Substring(0,
                        90) + "..." : course.Description)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                                <span class="fw-bold text-success fs-5">$@course.Price</span>
                                <span class="text-muted small"><i class="bi bi-people text-warning me-1"></i> Available</span>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2">
                                <a href="/Students/AllCourses/Details/@course.Id"
                                   class="btn btn-outline-primary btn-sm rounded-3 flex-grow-1">View Details</a>
                                <a href="/Cart/Add/@course.Id" class="btn btn-primary btn-sm rounded-3 px-3"
                                   title="Add to Cart">
                                    <i class="bi bi-cart-plus"></i>
                                </a>
                                <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Add to Wishlist">
                                    <i class="bi bi-heart"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center py-5 rounded-4 shadow-sm">
                    <i class="bi bi-journal-x fs-1 d-block mb-3 text-primary"></i>
                    <h5 class="fw-bold text-dark">No Courses Available</h5>
                    <p class="text-muted mb-0">There are no courses published in the system yet.</p>
                </div>
            </div>
        }
    </div>
</div>