@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid">
    <!-- Welcome Header & Explore Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Welcome back, Student! 👋</h3>
            <p class="text-muted small">Here are your enrolled courses and popular courses you might like.</p>
        </div>
        <div>
            <a asp-controller="Student" asp-action="Explore" class="btn btn-primary rounded-3 shadow-sm px-3">
                <i class="bi bi-compass me-1"></i> Explore All Courses
            </a>
        </div>
    </div>

    <!-- Section 1: My Enrolled Courses (Grid View) -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-check text-primary me-2"></i> My Enrolled Courses
            </h5>
            <a asp-controller="Student" asp-action="MyCourses"
               class="text-decoration-none text-primary small fw-semibold">
                View All
            </a>
        </div>

        <div class="row g-4">
            <!-- Enrolled Course Card 1 -->
            <div class="col-xl-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                    <div class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center position-relative"
                         style="height: 160px;">
                        <i class="bi bi-play-circle fs-1 opacity-75"></i>
                        <span class="position-absolute top-0 end-0 m-3 badge bg-primary px-3 py-2 rounded-pill">
                            Active
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <span class="text-muted small fw-semibold mb-1">Web Development</span>
                        <h5 class="fw-bold text-dark mb-2">React.js Advanced Masterclass</h5>

                        <!-- Progress Bar -->
                        <div class="mt-2 mb-1">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Progress</span>
                                <span>65%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 65%;"></div>
                            </div>
                        </div>

                        <div class="mt-auto pt-3">
                            <a href="/Student/WatchCourse/1" class="btn btn-primary btn-sm rounded-3 w-100 shadow-sm">
                                <i class="bi bi-play-fill me-1"></i> Continue Learning
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Enrolled Course Card 2 -->
            <div class="col-xl-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                    <div class="bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center position-relative"
                         style="height: 160px;">
                        <i class="bi bi-play-circle fs-1 opacity-75"></i>
                        <span class="position-absolute top-0 end-0 m-3 badge bg-success px-3 py-2 rounded-pill">
                            Active
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <span class="text-muted small fw-semibold mb-1">Backend Development</span>
                        <h5 class="fw-bold text-dark mb-2">Complete Laravel & Node.js API</h5>

                        <!-- Progress Bar -->
                        <div class="mt-2 mb-1">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Progress</span>
                                <span>30%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 30%;"></div>
                            </div>
                        </div>

                        <div class="mt-auto pt-3">
                            <a href="/Student/WatchCourse/2" class="btn btn-outline-success btn-sm rounded-3 w-100">
                                <i class="bi bi-play-fill me-1"></i> Continue Learning
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Popular Courses (Best-sellers) -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-fire text-danger me-2"></i> Popular Courses</h5>
            <span class="text-muted small">Top selling courses on platform</span>
        </div>

        <div class="row g-4">
            <!-- Popular Course Card 1 -->
            <div class="col-xl-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                    <div class="bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center position-relative"
                         style="height: 160px;">
                        <i class="bi bi-award fs-1 opacity-75"></i>
                        <span class="position-absolute top-0 end-0 m-3 badge bg-danger px-3 py-2 rounded-pill">
                            Best Seller
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <span class="text-muted small fw-semibold mb-1">UI/UX Design</span>
                        <h5 class="fw-bold text-dark mb-2">Figma to Web Design Essentials</h5>
                        <p class="text-muted small mb-3">
                            Learn wireframing, prototyping, and modern design principles.
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                            <span class="fw-bold text-success fs-5">$29.99</span>
                            <span class="text-muted small"><i class="bi bi-people text-warning me-1"></i> 520+
                                Students</span>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="#" class="btn btn-outline-primary btn-sm rounded-3 flex-grow-1">View Details</a>
                                <a href="#" class="btn btn-primary btn-sm rounded-3" title="Add to Cart">
                                    <i class="bi bi-cart-plus"></i>
                                </a>
                                <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Add to Wishlist">
                                    <i class="bi bi-heart"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Popular Course Card 2 -->
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                        <div class="bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center position-relative"
                             style="height: 160px;">
                            <i class="bi bi-code-slash fs-1 opacity-75"></i>
                            <span class="position-absolute top-0 end-0 m-3 badge bg-danger px-3 py-2 rounded-pill">
                                Hot
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <span class="text-muted small fw-semibold mb-1">Data Science & AI</span>
                            <h5 class="fw-bold text-dark mb-2">Python for Data Science & Machine Learning</h5>
                            <p class="text-muted small mb-3">Master Pandas, NumPy, Scikit-Learn, and build predictive
                                models.</p>

                                <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                                    <span class="fw-bold text-success fs-5">$59.99</span>
                                    <span class="text-muted small"><i class="bi bi-people text-warning me-1"></i> 740+
                                        Students</span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="#" class="btn btn-outline-primary btn-sm rounded-3 flex-grow-1">View Details</a>
                                        <a href="#" class="btn btn-primary btn-sm rounded-3" title="Add to Cart">
                                            <i class="bi bi-cart-plus"></i>
                                        </a>
                                        <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Add to Wishlist">
                                            <i class="bi bi-heart"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>