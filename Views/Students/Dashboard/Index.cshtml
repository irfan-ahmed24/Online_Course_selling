@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid">
    <!-- Welcome Header & Explore Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Welcome back, Student! 👋</h3>
            <p class="text-muted small">Here are your enrolled courses and popular courses you might like.</p>
        </div>
        <div>
            <a href="/Students/AllCourses" class="btn btn-primary rounded-3 shadow-sm px-3">
                <i class="bi bi-compass me-1"></i> Explore All Courses
            </a>
        </div>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Section 1: My Enrolled Courses (Dynamic) -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-check text-primary me-2"></i> My Enrolled Courses
            </h5>
        </div>

        <div class="row g-4">
            @{
                var enrolledCourses = ViewBag.EnrolledCourses as List<My_project.Models.Course>;
            }

            @if (enrolledCourses != null && enrolledCourses.Any())
            {
                foreach (var course in enrolledCourses)
                {
                    <div class="col-xl-4 col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                            <div class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center position-relative"
                                 style="height: 160px;">
                                <i class="bi bi-play-circle fs-1 opacity-75"></i>
                                <span
                                class="position-absolute top-0 end-0 m-3 badge bg-primary px-3 py-2 rounded-pill">Active</span>
                            </div>
                            <div class="card-body d-flex flex-column p-4">
                                <span class="text-muted small fw-semibold mb-1">Enrolled Course</span>
                                <h5 class="fw-bold text-dark mb-2">@course.Title</h5>

                                <!-- Progress Bar (Placeholder or from DB if you have progress table) -->
                                <div class="mt-2 mb-1">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Progress</span>
                                        <span>0%</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: 0%;"></div>
                                    </div>
                                </div>

                                <div class="mt-auto pt-3">
                                    <a href="/Student/WatchCourse/@course.Id"
                                       class="btn btn-primary btn-sm rounded-3 w-100 shadow-sm">
                                        <i class="bi bi-play-fill me-1"></i> Continue Learning
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center py-4 rounded-4 shadow-sm">
                        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                        You haven't enrolled in any courses yet. Explore courses and start learning today!
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Section 2: Popular Courses (Dynamic) -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-fire text-danger me-2"></i> Popular Courses</h5>
            <span class="text-muted small">Top available courses on platform</span>
        </div>

        <div class="row g-4">
            @{
                var popularCourses = ViewBag.PopularCourses as List<My_project.Models.Course>;
            }

            @if (popularCourses != null && popularCourses.Any())
            {
                foreach (var course in popularCourses)
                {
                    <div class="col-xl-4 col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                            <div class="bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center position-relative"
                                 style="height: 160px;">
                                <i class="bi bi-award fs-1 opacity-75"></i>
                                <span
                                class="position-absolute top-0 end-0 m-3 badge bg-danger px-3 py-2 rounded-pill">Hot</span>
                            </div>
                            <div class="card-body d-flex flex-column p-4">
                                <span class="text-muted small fw-semibold mb-1">Course</span>
                                <h5 class="fw-bold text-dark mb-2">@course.Title</h5>
                                <p class="text-muted small mb-3">
                                    @(course.Description != null && course.Description.Length > 80 ?
                            course.Description.Substring(0, 80) + "..." : course.Description)
                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                                    <span class="fw-bold text-success fs-5">$@course.Price</span>
                                    <span class="text-muted small"><i class="bi bi-people text-warning me-1"></i>
                                        Students</span>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="/Courses/Details/@course.Id"
                                           class="btn btn-outline-primary btn-sm rounded-3 flex-grow-1">View Details</a>
                                        <a href="/Cart/Add/@course.Id" class="btn btn-primary btn-sm rounded-3" title="Add to Cart">
                                            <i class="bi bi-cart-plus"></i>
                                        </a>
                                        <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Add to Wishlist">
                                            <i class="bi bi-heart"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            else
                {
                    <div class="col-1"></div>
                    <div class="col-12 text-center text-muted py-3">No more courses available right now.</div>
                }
            </div>
        </div>
    </div>