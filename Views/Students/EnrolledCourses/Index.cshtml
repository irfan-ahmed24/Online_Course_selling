@model IEnumerable<My_project.Models.Course>

@{
    ViewData["Title"] = "My Enrolled Courses";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">My Enrolled Courses</h3>
            <p class="text-muted small">Access and continue learning from the courses you have purchased.</p>
        </div>
        <div>
            <a href="/Students/AllCourses" class="btn btn-primary rounded-3 shadow-sm px-3">
                <i class="bi bi-compass me-1"></i> Explore More Courses
            </a>
        </div>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Enrolled Courses Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var course in Model)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                        <div class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center position-relative"
                             style="height: 170px;">
                            <i class="bi bi-play-circle fs-1 opacity-75"></i>
                            <span class="position-absolute top-0 end-0 m-3 badge bg-primary px-3 py-2 rounded-pill">
                                Active
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <span class="text-muted small fw-semibold mb-1">Web Development</span>
                            <h5 class="fw-bold text-dark mb-2">@course.Title</h5>
                            <p class="text-muted small mb-3">Instructor: @(course.Teacher != null ? course.Teacher.FullName :
                                                                                     "N/A")</p>

                                <!-- Progress Bar (Placeholder, you can bind actual progress if available) -->
                                <div class="mt-auto mb-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Course Progress</span>
                                        <span class="fw-semibold text-primary">0%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: 0%;"></div>
                                    </div>
                                </div>

                                <!-- Action Button -->
                                <a href="/Student/WatchCourse/@course.Id" class="btn btn-primary rounded-3 w-100 shadow-sm">
                                    <i class="bi bi-play-fill me-1"></i> Continue Learning
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center py-5 rounded-4 shadow-sm">
                        <i class="bi bi-journal-x fs-1 d-block mb-3 text-primary"></i>
                        <h5 class="fw-bold text-dark">No Enrolled Courses Found</h5>
                        <p class="text-muted mb-3">You haven't purchased or enrolled in any courses yet.</p>
                        <a href="/Students/AllCourses" class="btn btn-primary btn-sm rounded-3 px-4">Browse Courses</a>
                    </div>
                </div>
            }
        </div>
    </div>