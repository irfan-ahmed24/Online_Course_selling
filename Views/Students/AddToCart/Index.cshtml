@model IEnumerable<My_project.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-cart3 text-primary me-2"></i> Shopping Cart</h2>
        <p class="text-muted small">Review your selected courses before proceeding to checkout.</p>
    </div>

    <!-- Success/Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Left Side: Cart Items List -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">Cart Items (@Model.Count())</h5>
                    <hr class="text-muted opacity-25">

                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model)
                        {
                            <div
                                class="d-flex align-items-center justify-content-between p-3 border rounded-3 bg-light bg-opacity-50">
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Course Thumbnail -->
                                    <div class="rounded-3 overflow-hidden bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width: 80px; height: 60px;">
                                        @if (item.Course != null && !string.IsNullOrEmpty(item.Course.ThumbnailUrl))
                                        {
                                            <img src="@item.Course.ThumbnailUrl" alt="@item.Course.Title"
                                                 class="w-100 h-100 object-fit-cover">
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-earmark-play fs-3 text-primary"></i>
                                        }
                                    </div>

                                    <!-- Course Title & Info -->
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@(item.Course != null ? item.Course.Title : "Course Title")</h6>
                                        <span class="text-muted small">Instructor: @(item.Course?.Teacher?.FullName ?? "Expert Instructor")</span>
                                    </div>
                                </div>

                                <!-- Price & Remove Button -->
                                <div class="d-flex align-items-center gap-4">
                                    <span class="fw-bold text-success fs-5">$@(item.Course?.Price ?? 0)</span>

                                    <!-- Remove Form -->
                                    <form asp-controller="AddToCart" asp-action="Remove" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to remove this course?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3"
                                                title="Remove from Cart">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                    <h5 class="fw-bold text-dark mb-3">Order Summary</h5>
                    <hr class="text-muted opacity-25">

                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Subtotal</span>
                        <span class="fw-bold text-dark">$@Model.Sum(x => x.Course?.Price ?? 0)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Discount</span>
                        <span class="text-success fw-bold">$0.00</span>
                    </div>

                    <hr class="text-muted opacity-25">

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold text-dark fs-5">Total</span>
                        <span class="fw-bold text-success fs-4">$@Model.Sum(x => x.Course?.Price ?? 0)</span>
                    </div>

                    <!-- Checkout Button -->
                    <a href="/Students/Checkout" class="btn btn-primary w-100 rounded-3 py-3 fw-bold shadow-sm mb-2">
                        <i class="bi bi-shield-check me-1"></i> Proceed to Checkout
                    </a>
                    <a href="/Students/AllCourses" class="btn btn-outline-secondary w-100 rounded-3 py-2 fw-semibold">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart State -->
        <div class="row justify-content-center">
            <div class="col-md-6 text-center py-5">
                <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                    <div class="mb-3 text-muted opacity-50">
                        <i class="bi bi-cart-x display-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Your Cart is Empty</h4>
                    <p class="text-muted mb-4">Looks like you haven't added any courses to your cart yet.</p>
                    <a href="/Students/AllCourses" class="btn btn-primary rounded-pill py-2 px-4 fw-bold">
                        Explore Courses
                    </a>
                </div>
            </div>
        </div>
    }
</div>