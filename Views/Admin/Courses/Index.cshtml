@{
    ViewData["Title"] = "Manage Courses";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Course Management</h3>
            <p class="text-muted small">Review, approve, or reject instructor-submitted courses.</p>
        </div>
        <div class="btn-group shadow-sm rounded-3" role="group">
            <button type="button" class="btn btn-outline-primary active btn-sm px-3">All Courses</button>
            <button type="button" class="btn btn-outline-primary btn-sm px-3">Pending</button>
            <button type="button" class="btn btn-outline-primary btn-sm px-3">Approved</button>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3">Course Title</th>
                        <th class="py-3">Instructor</th>
                        <th class="py-3">Price</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-warning bg-opacity-10 text-warning rounded-3 d-flex align-items-center justify-content-center me-3"
                                     style="width: 45px; height: 45px; font-weight: bold;">
                                    <i class="bi bi-journal-code fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">React.js Advanced Masterclass</div>
                                    <small class="text-muted">Submitted: Aug 15, 2026</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-dark fw-semibold">Sabbir Khan</span>
                            <br><small class="text-muted">sabbir@example.com</small>
                        </td>
                        <td class="fw-bold text-success">$49.99</td>
                        <td>
                            <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2">Pending Review</span>
                        </td>
                        <td class="text-end">
                            <form asp-controller="Admin" asp-action="ApproveCourse" method="post" class="d-inline">
                                <input type="hidden" name="courseId" value="1" />
                                <button type="submit" class="btn btn-sm btn-success rounded-3 me-1"
                                        title="Approve Course">
                                    <i class="bi bi-check-lg"></i> Approve
                                </button>
                            </form>
                            <form asp-controller="Admin" asp-action="RejectCourse" method="post" class="d-inline">
                                <input type="hidden" name="courseId" value="1" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3"
                                        title="Reject Course">
                                    <i class="bi bi-x-lg"></i> Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center me-3"
                                     style="width: 45px; height: 45px; font-weight: bold;">
                                    <i class="bi bi-file-earmark-code fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">Complete Laravel & Vue.js SaaS</div>
                                    <small class="text-muted">Submitted: Aug 10, 2026</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-dark fw-semibold">Rahim Ahmed</span>
                            <br><small class="text-muted">rahim@example.com</small>
                        </td>
                        <td class="fw-bold text-success">$59.99</td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">Approved & Live</span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary rounded-3" title="View Details">
                                <i class="bi bi-eye"></i> Details
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>