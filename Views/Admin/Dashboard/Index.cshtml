@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Platform Overview</h3>
            <p class="text-muted small">Managing Teachers, Courses, and Enrollments.</p>
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">Pending Courses</div>
                <h4 class="fw-bold text-warning">12</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">New Teachers (Unverified)</div>
                <h4 class="fw-bold text-primary">5</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">Total Enrollments</div>
                <h4 class="fw-bold text-success">840</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">Total Revenue</div>
                <h4 class="fw-bold text-dark">$8,200</h4>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <h5 class="fw-bold mb-3">Pending Course Approvals</h5>
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course Title</th>
                            <th>Instructor</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>React.js Masterclass</td>
                            <td>Mr. Rahim</td>
                            <td><span class="badge bg-warning text-dark">Reviewing</span></td>
                            <td>
                                <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></button>
                                <button class="btn btn-sm btn-danger"><i class="bi bi-x-lg"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <h5 class="fw-bold mb-3">Verify Instructors</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            <div class="fw-bold">Karim Uddin</div>
                            <small class="text-muted">Applied: 2h ago</small>
                        </div>
                        <button class="btn btn-sm btn-outline-primary">Approve</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>