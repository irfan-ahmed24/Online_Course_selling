@model My_project.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Platform Overview</h3>
            <p class="text-muted small">Managing Teachers, Courses, and Enrollments.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">Pending Courses</div>
                <h4 class="fw-bold text-warning">@Model.PendingCoursesCount</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">New Teachers (Unverified)</div>
                <h4 class="fw-bold text-primary">@Model.PendingTeachersCount</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">Total Enrollments</div>
                <h4 class="fw-bold text-success">@Model.TotalEnrollments</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 border-0 shadow-sm rounded-3">
                <div class="text-muted small">Total Revenue</div>
                <h4 class="fw-bold text-dark">$@Model.TotalRevenue</h4>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Pending Course Approvals Table -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <h5 class="fw-bold mb-3">Pending Course Approvals</h5>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course Title</th>
                                <th>Instructor</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PendingCourses != null && Model.PendingCourses.Any())
                            {
                                foreach (var course in Model.PendingCourses)
                                {
                                    <tr>
                                        <td class="fw-semibold">@course.Title</td>
                                        <td>@(course.Teacher?.FullName ?? "Unknown")</td>
                                        <td><span class="badge bg-warning text-dark">Reviewing</span></td>
                                        <td>
                                            <form asp-action="ApproveCourse" asp-route-id="@course.Id" method="post"
                                                  class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success rounded-3 me-1"
                                                        title="Approve">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No pending courses found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Verify Instructors List -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <h5 class="fw-bold mb-3">Verify Instructors</h5>
                <ul class="list-group list-group-flush">
                    @if (Model.PendingTeachers != null && Model.PendingTeachers.Any())
                    {
                        foreach (var teacher in Model.PendingTeachers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-bold">@teacher.FullName</div>
                                    <small class="text-muted">@teacher.Email</small>
                                </div>
                                <form asp-action="ApproveTeacher" asp-route-id="@teacher.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-3 px-3">Approve</button>
                                </form>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted border-0 py-3">No pending teachers.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>