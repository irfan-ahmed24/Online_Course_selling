@{
    ViewData["Title"] = "Admin Profile";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="mb-4">
        <h3 class="fw-bold text-dark">Admin Profile Settings</h3>
        <p class="text-muted small">Update your personal information and secure your account.</p>
    </div>

    <!-- Success / Error Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                         style="width: 100px; height: 100px; font-size: 32px; font-weight: bold;">
                        AD
                    </div>
                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2"
                          title="Active Admin"></span>
                </div>
                <h5 class="fw-bold mb-1">Administrator</h5>
                <p class="text-muted small mb-3">admin@onlinecourse.com</p>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Super Admin</span>
            </div>
        </div>

        <!-- Right Column: Update Forms -->
        <div class="col-lg-8">
            <!-- General Information Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-gear text-primary me-2"></i> Profile Information</h5>

                <form asp-controller="Admin" asp-action="UpdateProfile" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="FullName" class="form-control rounded-3" value="Administrator"
                                   required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" class="form-control rounded-3"
                                   value="admin@onlinecourse.com" required>
                        </div>
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>

            <!-- Change Password Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock text-danger me-2"></i> Change Password</h5>

                <form asp-controller="Admin" asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label">Current Password</label>
                        <input type="password" name="CurrentPassword" class="form-control rounded-3"
                               placeholder="Enter current password" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control rounded-3"
                                   placeholder="Enter new password" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control rounded-3"
                                   placeholder="Confirm new password" required>
                        </div>
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-outline-danger px-4 rounded-3">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>