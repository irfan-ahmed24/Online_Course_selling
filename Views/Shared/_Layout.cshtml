<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Course Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-light" style="padding-top: 75px;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light custom-navbar py-3 fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 text-dark d-flex align-items-center gap-2" href="/"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill text-warning"></i> Online Course Platform
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    </ul>
                    <form class="d-flex mx-lg-auto my-2 my-lg-0 position-relative" asp-controller="Course"
                          asp-action="Index" method="get" style="width: 100%; max-width: 450px;">
                        <span class="search-icon-wrapper">
                            <i class="bi bi-search"></i>
                        </span>
                        <input class="form-control py-2 form-control-sm udemy-search-input text-dark" type="search"
                               name="searchString" placeholder="Search for anything" aria-label="Search">
                    </form>
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">

                        <a class="btn btn-outline-dark btn-sm px-3 py-2 fw-semibold" href="/Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </a>
                        <a class="btn btn-dark btn-sm px-3 py-2 fw-semibold text-white shadow-sm" href="/Register">
                            <i class="bi bi-person-plus-fill me-1 text-warning"></i> Register
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="container my-4 flex-grow-1">
        <div role="main" class="pb-3">
            @RenderBody()
        </div>
    </main>
    <footer class="bg-secondary text-white-50 py-2 mt-auto border-top border-secondary">
        <div class="container text-center">
            <p class="mb-1 text-light fw-medium">&copy; 2026 - OnlineCourseApp. All rights reserved.</p>
            <small class="text-white-50">Built with ASP.NET Core MVC & Bootstrap 5</small>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>