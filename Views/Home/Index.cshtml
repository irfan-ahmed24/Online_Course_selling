@{
    ViewData["Title"] = "Home Page - Online Course Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-5 mb-5 rounded-4 text-white shadow-sm position-relative overflow-hidden"
     style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="container py-5 position-relative" style="z-index: 2;">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-bold rounded-pill">New Skills, New
                    Opportunities
                </span>
                <h1 class="display-4 fw-bold mb-3">Learn from the best, be your best</h1>
                <p class="lead mb-4 text-white-50">Discover thousands of online courses taught by expert instructors.
                    Upgrade your career in tech, business, design, and more.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Course" asp-action="Index"
                       class="btn btn-warning btn-lg px-4 fw-bold text-dark shadow">Explore Courses</a>
                </div>
            </div>
        </div>
    </div>
    <div class="position-absolute top-0 end-0 h-100 w-50 opacity-10 d-none d-lg-block"
         style="background: radial-gradient(circle, #f59e0b 0%, transparent 70%);">
    </div>
</div>
<div class="container mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-3 shadow-sm border-0 h-100">
                <div class="text-warning fs-1 mb-2"><i class="bi bi-journal-code"></i></div>
                <h5 class="fw-bold">10+ Online Courses</h5>
                <p class="text-muted small mb-0">Explore a variety of fresh topics and build real-world projects.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-3 shadow-sm border-0 h-100">
                <div class="text-warning fs-1 mb-2"><i class="bi bi-award-fill"></i></div>
                <h5 class="fw-bold">Expert Instructors</h5>
                <p class="text-muted small mb-0">Learn from industry professionals who are passionate about teaching.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-3 shadow-sm border-0 h-100">
                <div class="text-warning fs-1 mb-2"><i class="bi bi-infinity"></i></div>
                <h5 class="fw-bold">Lifetime Access</h5>
                <p class="text-muted small mb-0">Learn at your own pace with unlimited access on mobile and desktop.</p>
            </div>
        </div>
    </div>
</div>
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">Featured Courses</h2>
        <a asp-controller="Course" asp-action="Index" class="text-decoration-none text-blue fw-semibold">See All
            Courses <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                     style="height: 180px;">
                    <i class="bi bi-file-earmark-play fs-1 text-warning"></i>
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-light text-dark align-self-start mb-2 border">Development</span>
                    <h5 class="card-title fw-bold">Complete ASP.NET Core MVC Guide</h5>
                    <p class="card-text text-muted small flex-grow-1">Learn to build enterprise-level web applications
                        using C# and Entity Framework Core.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold text-dark fs-5">$49.99</span>
                        <a href="#" class="btn btn-outline-dark btn-sm fw-semibold">View Details</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sample Course Card 2 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                     style="height: 180px;">
                    <i class="bi bi-file-earmark-play fs-1 text-warning"></i>
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-light text-dark align-self-start mb-2 border">Frontend</span>
                    <h5 class="card-title fw-bold">Mastering Modern JavaScript & React</h5>
                    <p class="card-text text-muted small flex-grow-1">Build fast, interactive, and responsive web
                        applications with React.js components.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold text-dark fs-5">$39.99</span>
                        <a href="#" class="btn btn-outline-dark btn-sm fw-semibold">View Details</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sample Course Card 3 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                     style="height: 180px;">
                    <i class="bi bi-file-earmark-play fs-1 text-warning"></i>
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-light text-dark align-self-start mb-2 border">Database</span>
                    <h5 class="card-title fw-bold">SQL & Database Design Masterclass</h5>
                    <p class="card-text text-muted small flex-grow-1">Master relational databases, write complex
                        queries, and design robust architectures.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold text-dark fs-5">$29.99</span>
                        <a href="#" class="btn btn-outline-dark btn-sm fw-semibold">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5 py-4">
    <h2 class="fw-bold text-dark mb-4 text-center">Top Categories</h2>
    <div class="row row-cols-2 row-cols-md-4 g-3 text-center">
        <div class="col">
            <div class="p-3 bg-white border rounded-3 shadow-sm hover-shadow">
                <i class="bi bi-code-slash fs-2 text-warning mb-2"></i>
                <h6 class="fw-bold mb-0">Development</h6>
            </div>
        </div>
        <div class="col">
            <div class="p-3 bg-white border rounded-3 shadow-sm hover-shadow">
                <i class="bi bi-graph-up-arrow fs-2 text-warning mb-2"></i>
                <h6 class="fw-bold mb-0">Business</h6>
            </div>
        </div>
        <div class="col">
            <div class="p-3 bg-white border rounded-3 shadow-sm hover-shadow">
                <i class="bi bi-palette fs-2 text-warning mb-2"></i>
                <h6 class="fw-bold mb-0">Design</h6>
            </div>
        </div>
        <div class="col">
            <div class="p-3 bg-white border rounded-3 shadow-sm hover-shadow">
                <i class="bi bi-shield-lock fs-2 text-warning mb-2"></i>
                <h6 class="fw-bold mb-0">Cybersecurity</h6>
            </div>
        </div>
    </div>
</div>