@model IEnumerable<My_project.Models.Course>

@{
    ViewData["Title"] = "My Courses";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">My Courses</h3>
            <p class="text-muted small">Manage your uploaded courses, lectures, and pricing.</p>
        </div>
        <a href="/Teachers/AddCourse" class="btn btn-success rounded-3 shadow-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Add New Course
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var course in Model)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">

                        <!-- Course Thumbnail / Banner Section -->
                        <div class="bg-light d-flex align-items-center justify-content-center position-relative overflow-hidden"
                             style="height: 180px;">

                            <!-- Thumbnail or Icon -->
                            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
                            {
                                <img src="@course.ThumbnailUrl" alt="Thumbnail" class="w-100 h-100 object-fit-cover" />
                            }
                            else
                            {
                                <div
                                    class="text-success bg-success bg-opacity-10 w-100 h-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-file-earmark-play fs-1 opacity-75"></i>
                                </div>
                            }

                            <!-- Status Badge (Absolute Positioned at Top-Right) -->
                            <div class="position-absolute top-0 end-0 m-3">
                                @if (course.IsCourseApproved)
                                {
                                    <span class="badge bg-success text-white px-3 py-2 shadow-sm rounded-pill fw-semibold">
                                        <i class="bi bi-check-circle me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 shadow-sm rounded-pill fw-semibold">
                                        <i class="bi bi-clock me-1"></i> Pending
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <span class="text-muted small fw-semibold mb-1">@course.Category</span>
                            <h5 class="fw-bold text-dark mb-2">@course.Title</h5>
                            <p class="text-muted small mb-3">
                                @(course.Description.Length > 80 ? course.Description.Substring(0, 80) + "..." :
                        course.Description)
                            </p>

                            <!-- Price & Total Video Count Section -->
                            <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                                <span class="fw-bold text-success fs-5">$@course.Price.ToString("0.00")</span>
                                <span class="text-muted small fw-semibold">
                                    <i class="bi bi-play-btn me-1"></i> @course.VideoCount Lectures
                                </span>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="/Teachers/MyCourses/CourseDetails/@course.Id"
                                   class="btn btn-outline-success btn-sm rounded-3 flex-grow-1">
                                    <i class="bi bi-play-circle me-1"></i> View Lectures
                                </a>
                                <a href="/Teachers/EditCourse/@course.Id" class="btn btn-light btn-sm rounded-3 text-secondary"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="javascript:void(0);" onclick="deleteCourse('@course.Id')"
                                   class="btn btn-light btn-sm rounded-3 text-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted fs-5">
                    <i class="bi bi-folder2-open display-4 d-block mb-2"></i> No courses found. Add your first course!
                </div>
            </div>
        }
    </div>
</div>

<script>
    async function deleteCourse(courseId) {
        if (confirm('Are you sure you want to delete this course and all its videos?')) {
            try {
                let response = await fetch('/Teachers/MyCourses/Delete/' + courseId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to delete the course.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Something went wrong!');
            }
        }
    }
</script>