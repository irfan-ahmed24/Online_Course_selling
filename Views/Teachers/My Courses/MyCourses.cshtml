@{
    ViewData["Title"] = "My Courses";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">My Courses</h3>
            <p class="text-muted small">Manage your uploaded courses, lectures, and pricing.</p>
        </div>
        <a href="/Teachers/AddCourse" class="btn btn-success rounded-3 shadow-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Add New Course
        </a>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row g-4">
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center position-relative"
                     style="height: 180px;">
                    <i class="bi bi-file-earmark-play fs-1 opacity-75"></i>
                    <span
                    class="position-absolute top-0 end-0 m-3 badge bg-success px-3 py-2 rounded-pill">Approved</span>
                </div>

                <div class="card-body d-flex flex-column p-4">
                    <span class="text-muted small fw-semibold mb-1">Web Development</span>
                    <h5 class="fw-bold text-dark mb-2">React.js Advanced Masterclass</h5>
                    <p class="text-muted small mb-3">Learn modern React, hooks, context API, and build professional
                        apps.
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                        <span class="fw-bold text-success fs-5">$49.99</span>
                        <span class="text-muted small"><i class="bi bi-people me-1"></i> 45 Students</span>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Teacher/CourseDetails/1" class="btn btn-outline-success btn-sm rounded-3 flex-grow-1">
                            <i class="bi bi-play-circle me-1"></i> View Lectures
                        </a>
                        <a href="#" class="btn btn-light btn-sm rounded-3 text-secondary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center position-relative"
                     style="height: 180px;">
                    <i class="bi bi-file-earmark-play fs-1 opacity-75"></i>
                    <span
                        class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark px-3 py-2 rounded-pill">Pending
                    </span>
                </div>

                <div class="card-body d-flex flex-column p-4">
                    <span class="text-muted small fw-semibold mb-1">Backend Development</span>
                    <h5 class="fw-bold text-dark mb-2">Complete Laravel & Node.js API</h5>
                    <p class="text-muted small mb-3">Master backend development, RESTful APIs, and database security.
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                        <span class="fw-bold text-success fs-5">$39.99</span>
                        <span class="text-muted small"><i class="bi bi-people me-1"></i> 28 Students</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/Teacher/CourseDetails/2" class="btn btn-outline-success btn-sm rounded-3 flex-grow-1">
                            <i class="bi bi-play-circle me-1"></i> View Lectures
                        </a>
                        <a href="#" class="btn btn-light btn-sm rounded-3 text-secondary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <!-- Course Thumbnail Placeholder -->
                <div class="bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center position-relative"
                     style="height: 180px;">
                    <i class="bi bi-file-earmark-play fs-1 opacity-75"></i>
                    <span class="position-absolute top-0 end-0 m-3 badge bg-success px-3 py-2 rounded-pill">Approved
                    </span>
                </div>

                <div class="card-body d-flex flex-column p-4">
                    <span class="text-muted small fw-semibold mb-1">UI/UX Design</span>
                    <h5 class="fw-bold text-dark mb-2">Figma to Web Design Essentials</h5>
                    <p class="text-muted small mb-3">Learn wireframing, prototyping, and modern web design principles.
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
                        <span class="fw-bold text-success fs-5">$29.99</span>
                        <span class="text-muted small"><i class="bi bi-people me-1"></i> 69 Students</span>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Teacher/CourseDetails/3" class="btn btn-outline-success btn-sm rounded-3 flex-grow-1">
                            <i class="bi bi-play-circle me-1"></i> View Lectures
                        </a>
                        <a href="#" class="btn btn-light btn-sm rounded-3 text-secondary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="#" class="btn btn-light btn-sm rounded-3 text-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>