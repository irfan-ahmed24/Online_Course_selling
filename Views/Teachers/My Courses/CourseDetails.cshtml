@model My_project.Models.Course

@{
    ViewData["Title"] = Model.Title;
    Layout = null; // কোনো লেআউট নেই
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - Course Details</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<body class="bg-light">

    <div class="container py-4">
        <!-- Back Button -->
        <div class="mb-4">
            <a href="/Teachers/MyCourses" class="btn btn-outline-dark btn-sm rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Courses
            </a>
        </div>

        <!-- Section 1: Video Player & Course Details -->
        <div class="row g-4 mb-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark">
                    <div class="ratio ratio-16x9">
                        <iframe id="mainVideoPlayer" src="" title="YouTube video player" frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen class="w-100 h-100"></iframe>
                    </div>
                </div>
                <h4 id="mainVideoTitle" class="mt-3 fw-bold text-dark">Select a lecture to play</h4>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success px-3 py-2 rounded-pill">@Model.Category</span>
                            <span class="fw-bold text-success fs-5">$@Model.Price.ToString("0.00")</span>
                        </div>
                        <h3 class="fw-bold text-dark mb-3">@Model.Title</h3>
                        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                        {
                            <img src="@Model.ThumbnailUrl" alt="Course Thumbnail" class="w-100 rounded-3 mb-3 shadow-sm"
                                 style="height: 140px; object-fit: cover;" />
                        }
                        <p class="text-muted small mb-3">@Model.Description</p>
                    </div>
                    <div class="border-top pt-3 mt-auto">
                        <div class="text-muted small fw-semibold">
                            <i class="bi bi-play-btn me-1"></i> Total Lectures: @Model.Lectures.Count()
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Lectures Grid -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold text-dark m-0"><i class="bi bi-grid me-2"></i> Course Lectures Grid</h4>
        </div>

        <div class="row g-4">
            @if (Model.Lectures != null && Model.Lectures.Any())
            {
                foreach (var lecture in Model.Lectures)
                {
                    string videoId = lecture.VideoUrl.Contains("watch?v=") ? lecture.VideoUrl.Split("watch?v=")[1].Split("&")[0]
            :
                                     (lecture.VideoUrl.Contains("youtu.be/") ? lecture.VideoUrl.Split("youtu.be/")[1].Split("?")[0] : "");

                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden lecture-card"
                             onclick="changeVideo('@lecture.VideoUrl', '@lecture.LectureTitle', this)"
                             style="cursor: pointer; transition: transform 0.2s;">
                            <div class="position-relative">
                                <img src="https://img.youtube.com/vi/@videoId/mqdefault.jpg" class="card-img-top"
                                     alt="Thumbnail" style="height: 150px; object-fit: cover;">
                                <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark bg-opacity-75 px-2 py-1 small">
                                    <i class="bi bi-play-fill"></i> Play
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <h6 class="fw-semibold text-dark text-truncate mb-2">@lecture.LectureTitle</h6>
                                <small class="text-muted"><i class="bi bi-youtube text-danger me-1"></i> YouTube Lecture</small>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- Add New Video Card -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card border-2 border-dashed border-success h-100 d-flex align-items-center justify-content-center rounded-4 shadow-sm"
                     style="background: #f8fff9; min-height: 200px; border-style: dashed !important;">
                    <div class="text-center p-4">
                        <i class="bi bi-plus-circle text-success fs-1"></i>
                        <h6 class="text-success fw-bold mt-2">Add New Video</h6>
                        <button type="button" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm"
                                data-bs-toggle="modal" data-bs-target="#addVideoModal">
                            <i class="bi bi-upload me-1"></i> Upload Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add New Video Modal -->
    <div class="modal fade" id="addVideoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="/Teachers/MyCourses/CourseDetails/AddLecture" method="post">
                    <input type="hidden" name="CourseId" value="@Model.Id" />
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Add New Lecture</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Video Title</label>
                            <input type="text" name="LectureTitle" class="form-control" required
                                   placeholder="Enter lecture title">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">YouTube Video URL</label>
                            <input type="url" name="VideoUrl" class="form-control" required
                                   placeholder="Paste YouTube link here">
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4">Upload Video</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function changeVideo(url, title, element) {
        let embedUrl = url.includes("watch?v=") ? "https://www.youtube.com/embed/" + url.split("watch?v=")[1].split("&")[0] + "?autoplay=1" :
        (url.includes("youtu.be/") ? "https://www.youtube.com/embed/" + url.split("youtu.be/")[1].split("?")[0] + "?autoplay=1" : url);

        document.getElementById('mainVideoPlayer').src = embedUrl;
        document.getElementById('mainVideoTitle').innerText = title;
        document.querySelectorAll('.lecture-card').forEach(card => card.classList.remove('border-success', 'border-2'));
        if (element) element.classList.add('border-success', 'border-2');
        }

        window.addEventListener('DOMContentLoaded', () => {
        const firstCard = document.querySelector('.lecture-card');
        if (firstCard) firstCard.click();
        });
    </script>
</body>

</html>