@{
    ViewData["Title"] = "Add New Course";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="mb-4">
        <h3 class="fw-bold text-dark">Create a New Course</h3>
        <p class="text-muted small">Fill up the details below to publish your course for students.</p>
    </div>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <form asp-controller="Teacher" asp-action="AddCourse" method="post" enctype="multipart/form-data">

            <h5 class="fw-bold text-success mb-3"><i class="bi bi-info-circle me-2"></i> Basic Information</h5>

            <div class="mb-3">
                <label class="form-label fw-semibold">Course Title</label>
                <input type="text" name="Title" class="form-control rounded-3"
                       placeholder="e.g. Complete Web Development Bootcamp 2026" required>
                <div class="form-text">A catchy and clear title for your course.</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="Category" class="form-select rounded-3" required>
                        <option value="" selected disabled>Select category</option>
                        <option value="Web Development">Web Development</option>
                        <option value="Mobile App Development">Mobile App Development</option>
                        <option value="UI/UX Design">UI/UX Design</option>
                        <option value="Data Science & AI">Data Science & AI</option>
                        <option value="Digital Marketing">Digital Marketing</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Price ($)</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3">$</span>
                        <input type="number" step="0.01" name="Price" class="form-control rounded-end-3"
                               placeholder="49.99" required>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Course Description</label>
                <textarea name="Description" class="form-control rounded-3" rows="4"
                          placeholder="Write a short summary of what students will learn in this course..." required>
                </textarea>
            </div>

            <hr class="text-muted opacity-25 my-4">

            <!-- Section 2: Media & Content -->
            <h5 class="fw-bold text-success mb-3"><i class="bi bi-file-earmark-play me-2"></i> Course Media & Lectures
            </h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Course Thumbnail Image</label>
                    <input type="file" name="ThumbnailImage" class="form-control rounded-3" accept="image/*">
                    <div class="form-text">Upload a banner image (Recommended size: 700x430 px).</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Intro / Sample YouTube Video URL</label>
                    <input type="url" name="IntroVideoUrl" class="form-control rounded-3"
                           placeholder="https://www.youtube.com/watch?v=...">
                    <div class="form-text">Add a preview video link for the course landing page.</div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Main Lecture Video Link (YouTube Embed or Video URL)</label>
                <input type="url" name="LectureVideoUrl" class="form-control rounded-3"
                       placeholder="https://www.youtube.com/watch?v=..." required>
                <div class="form-text">Students will watch this video inside the course player.</div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success px-4 rounded-3 shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Save & Submit Course
                </button>
                <a asp-controller="Teacher" asp-action="Courses" class="btn btn-outline-secondary px-4 rounded-3">Cancel
                </a>
            </div>
        </form>
    </div>
</div>