@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Instructor Dashboard</h3>
            <p class="text-muted small">Here is a summary of your courses, sales, and students activity.</p>
        </div>
        <div>
            <a href="/Teachers/AddCourse" class="btn btn-success rounded-3 shadow-sm px-3">
                <i class="bi bi-plus-lg me-1"></i> Create New Course
            </a>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-15 text-success rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="width: 50px; height: 50px;">
                        <i class="bi bi-journal-richtext fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small">Total Courses</span>
                        <h4 class="fw-bold mb-0 text-dark">6</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-15 text-primary rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="width: 50px; height: 50px;">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small">Enrolled Students</span>
                        <h4 class="fw-bold mb-0 text-dark">142</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-15 text-warning rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="width: 50px; height: 50px;">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small">Total Earnings</span>
                        <h4 class="fw-bold mb-0 text-dark">$1,280</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-15 text-info rounded-3 d-flex align-items-center justify-content-center me-3"
                         style="width: 50px; height: 50px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small">Pending Review</span>
                        <h4 class="fw-bold mb-0 text-dark">1</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark">Recent Student Enrollments</h5>
                    <a href="#" class="text-decoration-none text-success small fw-semibold">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">Student Name</th>
                                <th class="py-3">Course Enrolled</th>
                                <th class="py-3">Date</th>
                                <th class="py-3 text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                             style="width: 32px; height: 32px; font-size: 13px;">
                                            RA
                                        </div>
                                        <span class="fw-semibold">Rahim Ahmed</span>
                                    </div>
                                </td>
                                <td><span class="text-muted">React.js Advanced</span></td>
                                <td><small class="text-muted">Aug 15, 2026</small></td>
                                <td class="text-end fw-bold text-success">$49.99</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                             style="width: 32px; height: 32px; font-size: 13px;">
                                            NS
                                        </div>
                                        <span class="fw-semibold">Nusrat Sultana</span>
                                    </div>
                                </td>
                                <td><span class="text-muted">Node.js & Express API</span></td>
                                <td><small class="text-muted">Aug 14, 2026</small></td>
                                <td class="text-end fw-bold text-success">$39.99</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-success bg-opacity-10">
                <h5 class="fw-bold text-success mb-3"><i class="bi bi-lightbulb me-2"></i> Quick Tips</h5>
                <ul class="list-unstyled text-secondary small mb-0">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Make sure your course
                        videos are clear and high quality.
                    </li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Update your payout method
                        in settings to receive earnings on time.
                    </li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Respond to student questions promptly
                        to get positive reviews.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>