@{
    ViewData["Title"] = "Teacher Profile";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="mb-4">
        <h3 class="fw-bold text-dark">Instructor Profile Settings</h3>
        <p class="text-muted small">Update your personal information, public bio, and security credentials.</p>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm mx-auto"
                         style="width: 100px; height: 100px; font-size: 32px; font-weight: bold;">
                        TR
                    </div>
                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2"
                          title="Verified Instructor">
                    </span>
                </div>
                <h5 class="fw-bold mb-1">Sabbir Khan</h5>
                <p class="text-muted small mb-3">teacher@onlinecourse.com</p>
                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Verified
                    Instructor
                </span>
            </div>
        </div>
        <div class="col-lg-8">
            <!-- Profile Information Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-gear text-success me-2"></i> Personal Information</h5>

                <form asp-controller="Teacher" asp-action="UpdateProfile" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="FullName" class="form-control rounded-3" value="Sabbir Khan"
                                   required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" class="form-control rounded-3"
                                   value="teacher@onlinecourse.com" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Short Bio / Headline</label>
                        <input type="text" name="Bio" class="form-control rounded-3"
                               value="Full-Stack Web Developer & Instructor" placeholder="e.g. Senior Software Engineer">
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-success px-4 rounded-3 shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock text-danger me-2"></i> Change Password</h5>

                <form asp-controller="Teacher" asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label">Current Password</label>
                        <input type="password" name="CurrentPassword" class="form-control rounded-3"
                               placeholder="Enter current password" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control rounded-3"
                                   placeholder="Enter new password" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control rounded-3"
                                   placeholder="Confirm new password" required>
                        </div>
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-outline-danger px-4 rounded-3">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>